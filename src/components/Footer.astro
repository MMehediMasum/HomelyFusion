---
import { SITE_TITLE } from '../consts';

const today = new Date();

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';

// Shown as "More on Homely Fusion" pills. The page you're currently on is left out.
const footerLinks = [
	{ href: '/about/', label: 'About Us', icon: '🏡' },
	{ href: '/contact/', label: 'Contact', icon: '📬' },
	{ href: '/privacy-policy/', label: 'Privacy Policy', icon: '🔒' },
	{ href: '/disclosure/', label: 'Disclosure', icon: '💰' },
	{ href: '/terms/', label: 'Terms', icon: '📜' },
].filter((link) => normalize(link.href) !== normalize(Astro.url.pathname));
---

<footer>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<a class="brand" href="/" aria-label={`${SITE_TITLE} – home`}>
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 11.5 12 4l9 7.5" />
							<path d="M5.5 10v9.5h13V10" />
							<path d="M10 19.5v-5h4v5" />
						</svg>
					</span>
					<span class="brand-name">{SITE_TITLE}</span>
				</a>
				<p class="tagline">
					Home decor inspiration, styling ideas and practical buying guides for spaces that feel
					beautiful and lived-in.
				</p>
				<div class="social-links">
					<a
						href="https://www.facebook.com/GilbertPappas/"
						target="_blank"
						rel="nofollow noopener noreferrer"
					>
						<span class="sr-only">Follow Homely Fusion on Facebook</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
							<path
								fill="currentColor"
								d="M9.25 16V8.703h2.45l.367-2.845H9.25V4.04c0-.824.229-1.386 1.411-1.386h1.508V.11A20.21 20.21 0 0 0 9.97 0C7.795 0 6.305 1.327 6.305 3.764v2.094H3.846v2.845h2.459V16h2.945z"
							></path>
						</svg>
					</a>
				</div>
			</div>

			<nav class="related-nav" aria-label="More pages">
				<h2>More on {SITE_TITLE}</h2>
				<ul class="related-links">
					{
						footerLinks.map((link) => (
							<li>
								<a href={link.href}>
									<span aria-hidden="true">{link.icon}</span> {link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<p class="affiliate-note">
			Homely Fusion is a participant in the Amazon Services LLC Associates Program. As an Amazon
			Associate, we earn from qualifying purchases. <a href="/disclosure/">Learn more</a>.
		</p>

		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</span>
		</div>
	</div>
</footer>
<style>
	/* The footer is always deep green (both light and dark site themes), so it uses
	   fixed light colours instead of the theme variables. */
	footer {
		margin-top: 3rem;
		padding: 3rem 1.25rem 1.6rem;
		background:
			radial-gradient(ellipse 50% 90% at 100% 0%, rgba(217, 164, 65, 0.12), transparent 65%),
			linear-gradient(160deg, #1b3532 0%, #21403b 60%, #29493f 100%);
		border-top: 4px solid var(--brass);
		color: #c4d1c9;
		text-align: left;
		font-size: 0.95rem;
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
	}
	.footer-top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 2.5rem;
		align-items: start;
		padding-bottom: 2.2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #fbf3e2;
	}
	.brand:hover {
		color: #fbf3e2;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		background: rgba(255, 255, 255, 0.08);
		color: #fbf3e2;
		box-shadow: inset 0 0 0 1.5px rgba(217, 164, 65, 0.7);
	}
	.brand-name {
		font-family: var(--font-display);
		font-size: 1.35rem;
		line-height: 1;
	}
	.tagline {
		margin: 1rem 0 0;
		max-width: 38ch;
		line-height: 1.6;
		color: #a9bab0;
	}
	.social-links {
		display: flex;
		gap: 0.7rem;
		margin-top: 1.2rem;
	}
	.social-links a {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #e7efe9;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.social-links a:hover {
		background: var(--brass);
		border-color: var(--brass);
		color: #1b1b1b;
	}

	/* ---------- "More on Homely Fusion" pills ---------- */
	.related-nav h2 {
		margin: 0 0 1rem;
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--brass);
	}
	.related-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.related-links li {
		margin: 0;
	}
	.related-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.16);
		color: #f1f5f2;
		text-decoration: none;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 500;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.related-links a:hover {
		background: var(--brass);
		border-color: var(--brass);
		color: #1b1b1b;
		transform: translateY(-2px);
	}
	.affiliate-note {
		margin: 1.6rem 0 0;
		max-width: 70ch;
		font-size: 0.8rem;
		line-height: 1.6;
		color: #93a79c;
	}
	.affiliate-note a {
		color: #d6e0d9;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.affiliate-note a:hover {
		color: #fff;
	}
	.footer-bottom {
		margin-top: 1.2rem;
		font-size: 0.82rem;
		color: #93a79c;
	}

	@media (max-width: 760px) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
	@media (max-width: 480px) {
		footer {
			padding-top: 2.4rem;
		}
	}
</style>
