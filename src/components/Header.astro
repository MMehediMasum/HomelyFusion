---
import { slugify } from "../utils/slug";
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const posts = await getCollection("blog");
const topics = [...new Set(posts.map((post) => post.data.topic).filter(Boolean))].sort();
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} – home`}>
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 11.5 12 4l9 7.5" />
					<path d="M5.5 10v9.5h13V10" />
					<path d="M10 19.5v-5h4v5" />
				</svg>
			</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links" id="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<div class="dropdown">
				<button
					id="categories-trigger"
					class="dropdown-trigger"
					type="button"
					aria-haspopup="true"
					aria-expanded="false"
					aria-controls="categories-menu"
				>
					Topics
					<svg class="chevron" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M2 4.2 6 8l4-3.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<ul id="categories-menu" class="dropdown-menu">
					{
						topics.map((topic) => (
							<li>
								<a href={`/topic/${slugify(topic)}/`}>{topic}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="header-actions">
			<button id="theme-toggle" aria-label="Toggle dark mode" type="button">
				<span id="theme-icon">🌙</span>
			</button>
			<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<script>
	const themeButton = document.getElementById("theme-toggle");
	const themeIcon = document.getElementById("theme-icon");

	function syncIcon() {
		const current = document.documentElement.getAttribute("data-theme");
		if (themeIcon) themeIcon.textContent = current === "dark" ? "☀️" : "🌙";
	}
	syncIcon();

	themeButton?.addEventListener("click", () => {
		const current = document.documentElement.getAttribute("data-theme");
		const next = current === "dark" ? "light" : "dark";
		document.documentElement.setAttribute("data-theme", next);
		localStorage.setItem("theme", next);
		syncIcon();
	});

	const catTrigger = document.getElementById("categories-trigger");
	const catMenu = document.getElementById("categories-menu");

	catTrigger?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = catMenu?.classList.toggle("open");
		catTrigger.setAttribute("aria-expanded", String(!!isOpen));
	});

	document.addEventListener("click", () => {
		catMenu?.classList.remove("open");
		catTrigger?.setAttribute("aria-expanded", "false");
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			catMenu?.classList.remove("open");
			catTrigger?.setAttribute("aria-expanded", "false");
		}
	});

	const mobileToggle = document.getElementById("mobile-menu-toggle");
	const internalLinks = document.getElementById("internal-links");

	mobileToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = internalLinks?.classList.toggle("mobile-open");
		mobileToggle.setAttribute("aria-expanded", String(!!isOpen));
		mobileToggle.classList.toggle("active", !!isOpen);
	});

	internalLinks?.addEventListener("click", (e) => {
		const target = e.target;
		if (target instanceof HTMLElement && target.tagName === "A") {
			internalLinks.classList.remove("mobile-open");
			mobileToggle?.setAttribute("aria-expanded", "false");
			mobileToggle?.classList.remove("active");
		}
	});

	document.addEventListener("click", (e) => {
		if (
			internalLinks?.classList.contains("mobile-open") &&
			!internalLinks.contains(e.target) &&
			e.target !== mobileToggle
		) {
			internalLinks.classList.remove("mobile-open");
			mobileToggle?.setAttribute("aria-expanded", "false");
			mobileToggle?.classList.remove("active");
		}
	});
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.25em;
		background: var(--header-bg);
		-webkit-backdrop-filter: saturate(160%) blur(12px);
		backdrop-filter: saturate(160%) blur(12px);
		border-bottom: 1px solid var(--line);
		box-shadow: 0 1px 0 rgba(var(--brass-rgb), 0.35);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
		min-height: 66px;
	}

	/* ---------- Brand ---------- */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.brand:hover {
		color: rgb(var(--black));
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		background: linear-gradient(145deg, var(--accent), var(--accent-dark));
		color: #fbf3e2;
		box-shadow: inset 0 0 0 1.5px rgba(var(--brass-rgb), 0.55);
		transition: transform 0.25s ease;
	}
	.brand:hover .brand-mark {
		transform: rotate(-6deg) scale(1.05);
	}
	.brand-name {
		font-family: var(--font-display);
		font-size: 1.3rem;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	/* ---------- Links ---------- */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		margin-left: auto;
	}
	.internal-links > :global(a) {
		position: relative;
		padding: 1.4em 0.8em;
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 600;
		font-size: 0.92rem;
		letter-spacing: 0.01em;
		opacity: 0.78;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.internal-links > :global(a:hover) {
		opacity: 1;
		color: var(--link);
	}
	.internal-links > :global(a.active) {
		opacity: 1;
	}
	.internal-links > :global(a::after) {
		content: "";
		position: absolute;
		left: 0.8em;
		right: 0.8em;
		bottom: 0.95em;
		height: 2px;
		border-radius: 2px;
		background: var(--brass);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.internal-links > :global(a:hover::after),
	.internal-links > :global(a.active::after) {
		transform: scaleX(1);
	}

	/* ---------- Topics dropdown ---------- */
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: none;
		font-family: inherit;
		cursor: pointer;
		padding: 1.4em 0.8em;
		color: rgb(var(--black));
		font-weight: 600;
		font-size: 0.92rem;
		letter-spacing: 0.01em;
		opacity: 0.78;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.dropdown-trigger:hover,
	.dropdown-trigger[aria-expanded="true"] {
		opacity: 1;
		color: var(--link);
	}
	.chevron {
		transition: transform 0.2s ease;
	}
	.dropdown-trigger[aria-expanded="true"] .chevron {
		transform: rotate(180deg);
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% - 6px);
		right: 0;
		width: max-content;
		min-width: 250px;
		max-width: min(340px, 90vw);
		margin: 0;
		padding: 0.5rem;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 3px solid var(--brass);
		border-radius: 14px;
		box-shadow: var(--box-shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		z-index: 60;
	}
	.dropdown-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown-menu li {
		margin: 0;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 0.9em;
		border-radius: 9px;
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 500;
		font-size: 0.93rem;
		line-height: 1.35;
	}
	.dropdown-menu a:hover {
		background: var(--accent-soft);
		color: var(--link);
	}

	/* ---------- Actions ---------- */
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: 0.4rem;
	}
	#theme-toggle {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		background: rgb(var(--gray-light));
		border: 1px solid var(--line);
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.05rem;
		line-height: 1;
		padding: 0;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	#theme-toggle:hover {
		transform: rotate(18deg);
		background: var(--accent-soft);
	}
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 4px;
		width: 38px;
		height: 38px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: rgb(var(--black));
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* ---------- Mobile ---------- */
	@media (max-width: 640px) {
		header {
			padding: 0 1em;
		}
		nav {
			flex-wrap: wrap;
			min-height: 60px;
		}
		.brand-name {
			font-size: 1.15rem;
		}
		.header-actions {
			margin-left: auto;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			order: 3;
			gap: 0;
			margin-left: 0;
			padding: 0.3em 0 1em;
			border-top: 1px solid var(--line);
		}
		.internal-links.mobile-open {
			display: flex;
		}
		.internal-links > :global(a) {
			padding: 0.85em 0;
		}
		.internal-links > :global(a::after) {
			display: none;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-trigger {
			width: 100%;
			justify-content: space-between;
			padding: 0.85em 0;
		}
		.dropdown-menu {
			position: static;
			box-shadow: none;
			border: none;
			border-left: 3px solid var(--brass);
			border-radius: 0;
			opacity: 1;
			visibility: visible;
			transform: none;
			display: none;
			padding: 0.2em 0 0.2em 0.8em;
			margin: 0 0 0.4em 0.2em;
			width: auto;
			max-width: none;
			background: transparent;
		}
		.dropdown-menu a {
			padding: 0.55em 0.4em;
		}
		.dropdown-menu.open {
			display: block;
		}
	}
</style>
