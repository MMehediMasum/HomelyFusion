---
import { slugify } from "../../utils/slug";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");
	const topics = [...new Set(allPosts.map((post) => post.data.topic).filter(Boolean))];
	return topics.map((topic) => ({
		params: { topic: slugify(topic) },
		props: { topicName: topic },
	}));
}

const { topicName } = Astro.props;
const allPosts = await getCollection("blog");
const postsInTopic = allPosts.filter((post) => post.data.topic === topicName);

const categoryCounts = new Map();
for (const post of postsInTopic) {
	for (const category of post.data.categories ?? []) {
		categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
	}
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

function thumbUrl(category: string) {
	const q = encodeURIComponent(`${topicName} ${category}`);
	return `https://tse1.mm.bing.net/th?q=${q}&w=474&h=274&c=7`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${topicName} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 92vw);
				max-width: none;
				padding-top: 1.6rem;
			}

			/* ---------- Page header ---------- */
			.topic-header {
				position: relative;
				overflow: hidden;
				margin-bottom: 2.4rem;
				padding: 2.4rem 2rem 2.5rem;
				border-radius: var(--radius-lg);
				background:
					radial-gradient(ellipse 45% 90% at 100% 0%, rgba(217, 164, 65, 0.22), transparent 65%),
					radial-gradient(ellipse 50% 70% at 0% 100%, rgba(120, 170, 150, 0.18), transparent 65%),
					linear-gradient(160deg, #1b3532 0%, #21403b 60%, #29493f 100%);
				color: #c4d1c9;
				text-align: center;
			}
			.breadcrumb {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin: 0 0 1rem;
				padding: 0;
				list-style: none;
				font-size: 0.82rem;
			}
			.breadcrumb li {
				margin: 0;
			}
			.breadcrumb li + li::before {
				content: "/";
				margin-right: 0.4rem;
				opacity: 0.5;
			}
			.breadcrumb a {
				color: #d6e0d9;
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--brass);
			}
			.eyebrow {
				display: inline-block;
				margin-bottom: 0.7rem;
				padding: 0.25rem 0.8rem;
				border-radius: 999px;
				background: rgba(217, 164, 65, 0.16);
				border: 1px solid rgba(217, 164, 65, 0.5);
				color: var(--brass);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			.topic-title {
				margin: 0 auto 0.9rem;
				max-width: 24ch;
				color: #fbf3e2;
				font-size: clamp(1.9rem, 4.4vw, 2.9rem);
			}
			.topic-meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.6rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.topic-meta li {
				margin: 0;
				padding: 0.3rem 0.95rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.09);
				border: 1px solid rgba(255, 255, 255, 0.14);
				font-size: 0.88rem;
				color: #e1eae4;
			}

			/* ---------- Category cards ---------- */
			.category-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1.8rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.category-grid li {
				margin: 0;
			}
			.category-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				border-radius: var(--radius);
				overflow: hidden;
				background: var(--surface);
				border: 1px solid var(--line);
				box-shadow: var(--shadow-sm);
				text-decoration: none;
				color: rgb(var(--black));
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}
			.category-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
				border-color: rgba(var(--brass-rgb), 0.7);
				color: rgb(var(--black));
			}
			.thumb {
				position: relative;
				width: 100%;
				aspect-ratio: 474 / 274;
				overflow: hidden;
				background: linear-gradient(135deg, var(--accent-soft), rgb(var(--gray-light)));
			}
			.thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
				transition: transform 0.5s ease;
			}
			.category-card:hover .thumb img {
				transform: scale(1.06);
			}
			.count-pill {
				position: absolute;
				top: 0.7rem;
				right: 0.7rem;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
				background: rgba(20, 26, 23, 0.72);
				-webkit-backdrop-filter: blur(6px);
				backdrop-filter: blur(6px);
				color: #fff;
				font-size: 0.74rem;
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				padding: 1rem 1.2rem 1.1rem;
			}
			.cat-name {
				margin: 0;
				font-size: 1.08rem;
				line-height: 1.32;
				min-height: calc(1.32em * 2);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				transition: color 0.2s ease;
			}
			.category-card:hover .cat-name {
				color: var(--link);
			}
			.explore {
				margin-top: auto;
				padding-top: 0.7rem;
				font-weight: 700;
				font-size: 0.85rem;
				color: var(--link);
			}
			.explore span {
				display: inline-block;
				transition: transform 0.2s ease;
			}
			.category-card:hover .explore span {
				transform: translateX(4px);
			}
			.empty {
				text-align: center;
				color: rgb(var(--gray));
			}

			@media (max-width: 560px) {
				.topic-header {
					padding: 1.7rem 1.1rem 1.8rem;
					border-radius: 18px;
				}
				.category-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 1rem;
				}
				.card-body {
					padding: 0.8rem 0.9rem 0.9rem;
				}
				.cat-name {
					font-size: 0.98rem;
				}
			}
			@media (max-width: 340px) {
				.category-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="topic-header">
				<ul class="breadcrumb">
					<li><a href="/">Home</a></li>
					<li aria-current="page">{topicName}</li>
				</ul>
				<span class="eyebrow">Topic</span>
				<h1 class="topic-title">{topicName}</h1>
				<ul class="topic-meta">
					<li>{categories.length} {categories.length === 1 ? "category" : "categories"}</li>
					<li>{postsInTopic.length} {postsInTopic.length === 1 ? "post" : "posts"}</li>
				</ul>
			</header>

			<section>
				{
					categories.length === 0 ? (
						<p class="empty">No categories found under this topic yet.</p>
					) : (
						<ul class="category-grid">
							{categories.map(([category, count]) => (
								<li>
									<a class="category-card" href={`/categories/${slugify(category)}/`}>
										<div class="thumb">
											<img
												src={thumbUrl(category)}
												alt=""
												width="474"
												height="274"
												loading="lazy"
												onerror="this.style.display='none'"
											/>
											<span class="count-pill">
												{count} {count === 1 ? "post" : "posts"}
											</span>
										</div>
										<div class="card-body">
											<h2 class="cat-name">{category}</h2>
											<span class="explore">
												Browse <span aria-hidden="true">→</span>
											</span>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
