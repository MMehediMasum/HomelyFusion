---
import StaticPage from '../layouts/StaticPage.astro';

const lastUpdated = 'October 8, 2026';
const CONTACT_EMAIL = 'gilbertjpappas@gmail.com';

const sections = [
	{ id: 'who', label: '🏡 Who we are', c1: '#35564f' },
	{ id: 'collect', label: '📥 What we collect', c1: '#7b5b41' },
	{ id: 'use', label: '🎯 How we use it', c1: '#566485' },
	{ id: 'legal', label: '⚖️ Legal basis', c1: '#7a2c3a' },
	{ id: 'share', label: '🤝 Who we share with', c1: '#a87a1e' },
	{ id: 'cookies', label: '🍪 Cookies', c1: '#47653d' },
	{ id: 'affiliate', label: '💰 Affiliate links & ads', c1: '#6b4256' },
	{ id: 'retention', label: '🗄️ Retention', c1: '#4a5560' },
	{ id: 'security', label: '🔐 Security', c1: '#35564f' },
	{ id: 'rights', label: '✋ Your rights', c1: '#7b5b41' },
	{ id: 'children', label: '🧒 Children', c1: '#566485' },
	{ id: 'changes', label: '🔄 Changes', c1: '#7a2c3a' },
	{ id: 'contact', label: '📬 Contact', c1: '#a87a1e' },
];
---

<StaticPage
	title="Privacy Policy"
	description="How Homely Fusion collects, uses, shares and protects your information, including cookies, analytics, affiliate links and your privacy rights under GDPR and CCPA."
	icon="🔒"
	eyebrow="Your privacy matters"
	lede="What we collect, why we collect it, who sees it and how you stay in control. Written to be read, not just clicked past."
	c1="#35564f"
	c2="#93b9ab"
	chips={[`🗓️ Last updated: ${lastUpdated}`, '🚫 We never sell your data', '🍪 You control cookies']}
>
	<div class="sp">
		<ul class="sp-glance">
			<li><span class="gi">🚫</span><b>No selling your data</b><small>We don't sell, rent or trade your personal information.</small></li>
			<li><span class="gi">📊</span><b>Anonymous analytics</b><small>We look at traffic trends to improve our guides.</small></li>
			<li><span class="gi">🍪</span><b>Cookie choices</b><small>Manage non-essential cookies through our consent banner or your browser.</small></li>
			<li><span class="gi">✋</span><b>Your rights</b><small>Ask to access, correct or delete your data any time.</small></li>
		</ul>

		<p class="sp-lead">
			By using <a href="https://homelyfusion.com">homelyfusion.com</a> (the "Site"), you agree to the practices described
			here. We want to be as clear as possible about how we handle your data while we share home decor ideas, buying
			guides and styling advice.
		</p>

		<nav class="sp-jump" aria-label="On this page">
			{sections.map((s) => <a href={`#${s.id}`} style={`--c1:${s.c1}`}>{s.label}</a>)}
		</nav>

		<!-- ===================== 1 ===================== -->
		<section class="sp-card" id="who" style="--c1:#35564f;--c2:#93b9ab">
			<div class="sp-head"><span class="sp-num">1</span><h2>Who we are</h2><span class="sp-ico">🏡</span></div>
			<p>
				Homely Fusion is a home and home decor website run by interior stylist <strong>Gilbert Pappas</strong> in
				Charleston, South Carolina. We publish design inspiration, product recommendations, DIY tips and shopping
				guides across topics like sofas and seating, bedroom and bathroom decor, lighting, rugs, wall decor, storage
				and seasonal decor.
			</p>
			<p>
				We are a <strong>for-profit website</strong>. We may earn income from affiliate links, sponsored content, display
				advertising and product partnerships (see our <a href="/disclosure/">Disclosure</a>). We aim to follow the data
				protection laws that apply to us, including the <strong>GDPR</strong> and the
				<strong>California Consumer Privacy Act (CCPA)</strong> where relevant.
			</p>
		</section>

		<!-- ===================== 2 ===================== -->
		<section class="sp-card" id="collect" style="--c1:#7b5b41;--c2:#d1ae82">
			<div class="sp-head"><span class="sp-num">2</span><h2>What information we collect</h2><span class="sp-ico">📥</span></div>
			<h3>a) Information you give us</h3>
			<ul class="sp-list cols">
				<li><span>✉️</span><span>Your <strong>email address</strong> and <strong>name</strong>, if you email us</span></li>
				<li><span>💬</span><span>The <strong>messages and questions</strong> you send</span></li>
				<li><span>📎</span><span>Any <strong>photos or details</strong> you choose to share about your room</span></li>
			</ul>
			<div class="sp-note info">
				<span>ℹ️</span>
				<p>
					We don't currently run user accounts, comments or a newsletter. If we add any of these, we'll update this
					page first.
				</p>
			</div>
			<h3>b) Information collected automatically</h3>
			<ul class="sp-chips">
				<li>🌐 IP address</li>
				<li>🧭 Browser &amp; version</li>
				<li>📱 Device type</li>
				<li>📄 Pages visited</li>
				<li>⏱️ Time on page</li>
				<li>🔗 Referring URL</li>
				<li>🖱️ Clicks</li>
			</ul>
			<p>
				We use <strong>Google Analytics</strong> and similar tools to understand how visitors use the Site, which helps
				us see which guides are useful and how to improve your experience.
			</p>
		</section>

		<!-- ===================== 3 ===================== -->
		<section class="sp-card" id="use" style="--c1:#566485;--c2:#b3c1de">
			<div class="sp-head"><span class="sp-num">3</span><h2>How we use your information</h2><span class="sp-ico">🎯</span></div>
			<ul class="sp-list cols">
				<li><span>💬</span><span>Reply to your questions and requests</span></li>
				<li><span>📈</span><span>Improve our content and Site performance</span></li>
				<li><span>📊</span><span>Analyze traffic trends and visitor behavior</span></li>
				<li><span>📣</span><span>Show relevant advertising, where ads are used</span></li>
				<li><span>🛡️</span><span>Prevent fraud, spam and abuse</span></li>
				<li><span>📜</span><span>Meet our legal obligations</span></li>
			</ul>
			<p><strong>We do not sell, rent or trade the personal information you send us.</strong></p>
		</section>

		<!-- ===================== 4 ===================== -->
		<section class="sp-card" id="legal" style="--c1:#7a2c3a;--c2:#dc7686">
			<div class="sp-head"><span class="sp-num">4</span><h2>Legal basis (for visitors in the EEA and UK)</h2><span class="sp-ico">⚖️</span></div>
			<p>If you're in the European Economic Area or the UK, we process your personal data only where:</p>
			<ul class="sp-list">
				<li><span>✅</span><span><strong>You've given consent</strong>, for example through our cookie banner. You can withdraw it at any time.</span></li>
				<li><span>📄</span><span><strong>It's needed to respond</strong> to a request you've made.</span></li>
				<li><span>⚖️</span><span><strong>It's required by law.</strong></span></li>
				<li><span>🛠️</span><span><strong>It serves our legitimate interests</strong>, such as improving the Site, answering inquiries and preventing fraud.</span></li>
			</ul>
		</section>

		<!-- ===================== 5 ===================== -->
		<section class="sp-card" id="share" style="--c1:#a87a1e;--c2:#f4d479">
			<div class="sp-head"><span class="sp-num">5</span><h2>Who we share information with</h2><span class="sp-ico">🤝</span></div>
			<p>We share information only with partners that help run and support the Site:</p>
			<ul class="sp-tiles">
				<li><span>☁️</span><b>Hosting &amp; delivery</b><small>Our website host and content delivery network (Cloudflare).</small></li>
				<li><span>📊</span><b>Analytics</b><small>Google Analytics, to understand site usage.</small></li>
				<li><span>🍪</span><b>Cookie consent</b><small>A consent-management tool (CookieYes), to record your cookie choices.</small></li>
				<li><span>💰</span><b>Ads &amp; affiliates</b><small>Ad networks and affiliate programs such as Amazon Associates.</small></li>
			</ul>
			<p>
				We may also disclose information if the law requires it, for example in response to a valid legal process. We
				don't sell or lease your personal data to third-party marketers.
			</p>
		</section>

		<!-- ===================== 6 ===================== -->
		<section class="sp-card" id="cookies" style="--c1:#47653d;--c2:#a3c78f">
			<div class="sp-head"><span class="sp-num">6</span><h2>Cookies and tracking technologies</h2><span class="sp-ico">🍪</span></div>
			<p>
				Cookies are small text files stored on your device that help websites remember preferences and understand how
				they're used. Like most sites, we use them to keep Homely Fusion working and to improve it.
			</p>
			<ul class="sp-tiles">
				<li style="--c1:#35564f;--c2:#93b9ab"><span>🔧</span><b>Essential</b><small>Needed for basic site functions.</small></li>
				<li style="--c1:#566485;--c2:#b3c1de"><span>📈</span><b>Performance</b><small>Help us see how the Site is used.</small></li>
				<li style="--c1:#a87a1e;--c2:#f4d479"><span>🌙</span><b>Functionality</b><small>Remember choices like dark mode.</small></li>
				<li style="--c1:#7a2c3a;--c2:#dc7686"><span>📣</span><b>Advertising &amp; affiliate</b><small>Used by ad networks and affiliate partners, such as Amazon.</small></li>
			</ul>
			<div class="sp-note warn">
				<span>🎛️</span>
				<p>
					<strong>You're in control.</strong> Use the cookie banner on our Site to choose which non-essential cookies
					to allow, and change your mind later. You can also block or delete cookies in your browser settings, though
					parts of the Site may not work as well.
				</p>
			</div>
		</section>

		<!-- ===================== 7 ===================== -->
		<section class="sp-card" id="affiliate" style="--c1:#6b4256;--c2:#cf93a8">
			<div class="sp-head"><span class="sp-num">7</span><h2>Affiliate links and advertisements</h2><span class="sp-ico">💰</span></div>
			<p>
				Some links on Homely Fusion are <strong>affiliate links</strong>: if you click through and buy, we may earn a
				commission at no extra cost to you. Programs we may take part in include Amazon Associates, CJ Affiliate,
				ShareASale, PartnerStack, Impact and other home-related networks. When you click an affiliate link, the
				retailer or network may place a cookie to credit the referral.
			</p>
			<p>
				We may also display <strong>third-party ads</strong>, which can use cookies to show ads based on your interests.
				Full details are on our <a href="/disclosure/">Disclosure page</a>.
			</p>
		</section>

		<!-- ===================== 8 ===================== -->
		<section class="sp-card" id="retention" style="--c1:#4a5560;--c2:#a9b6c2">
			<div class="sp-head"><span class="sp-num">8</span><h2>How long we keep your data</h2><span class="sp-ico">🗄️</span></div>
			<p>We keep personal information only as long as needed for the purposes above:</p>
			<ul class="sp-list">
				<li><span>✉️</span><span><strong>Emails you send us:</strong> as long as needed to help you, then deleted or archived securely.</span></li>
				<li><span>📊</span><span><strong>Analytics data:</strong> kept according to the analytics provider's retention settings (for example, up to 26 months in Google Analytics).</span></li>
			</ul>
		</section>

		<!-- ===================== 9 ===================== -->
		<section class="sp-card" id="security" style="--c1:#35564f;--c2:#93b9ab">
			<div class="sp-head"><span class="sp-num">9</span><h2>How we protect your data</h2><span class="sp-ico">🔐</span></div>
			<ul class="sp-list cols">
				<li><span>🔒</span><span>HTTPS encryption across the Site</span></li>
				<li><span>🔄</span><span>Regular software updates</span></li>
				<li><span>🙋</span><span>Limited access to your messages</span></li>
				<li><span>🏢</span><span>Reputable, secure third-party platforms</span></li>
			</ul>
			<p>
				No website or internet transmission is 100% secure, so we can't guarantee absolute security. We do take
				reasonable steps to protect what you share with us.
			</p>
		</section>

		<!-- ===================== 10 ===================== -->
		<section class="sp-card" id="rights" style="--c1:#7b5b41;--c2:#d1ae82">
			<div class="sp-head"><span class="sp-num">10</span><h2>Your privacy rights</h2><span class="sp-ico">✋</span></div>
			<p>Depending on where you live (including under the GDPR and the CCPA), you may have the right to:</p>
			<ul class="sp-list cols">
				<li><span>👁️</span><span><strong>Access</strong> the personal data we hold about you</span></li>
				<li><span>✏️</span><span><strong>Correct</strong> information that's wrong</span></li>
				<li><span>🗑️</span><span><strong>Delete</strong> your personal data</span></li>
				<li><span>📦</span><span><strong>Receive a copy</strong> of your data</span></li>
				<li><span>⏸️</span><span><strong>Object to or limit</strong> certain processing</span></li>
				<li><span>↩️</span><span><strong>Withdraw consent</strong> at any time</span></li>
			</ul>
			<p>
				California residents also have the right to know what personal information is collected and to opt out of its
				"sale" or "sharing". We don't sell the personal information you send us, and you can manage advertising
				cookies through our cookie banner. We won't treat you differently for exercising your rights.
			</p>
			<p>
				To make a request, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. We may need to confirm your
				identity first. If you're in the EEA or UK, you can also complain to your local data protection authority.
			</p>
		</section>

		<!-- ===================== 11 ===================== -->
		<section class="sp-card" id="children" style="--c1:#566485;--c2:#b3c1de">
			<div class="sp-head"><span class="sp-num">11</span><h2>Children's privacy</h2><span class="sp-ico">🧒</span></div>
			<p>
				Homely Fusion is meant for a general adult audience and is not directed at children under 13. We don't
				knowingly collect personal information from children. If you believe a child has sent us information, please
				contact us and we'll delete it.
			</p>
		</section>

		<!-- ===================== 12 ===================== -->
		<section class="sp-card" id="changes" style="--c1:#7a2c3a;--c2:#dc7686">
			<div class="sp-head"><span class="sp-num">12</span><h2>Changes to this policy</h2><span class="sp-ico">🔄</span></div>
			<p>
				We may update this Privacy Policy as the Site or the law changes. The "Last updated" date at the top of the
				page shows when it last changed. Continuing to use the Site after an update means you accept the revised
				policy.
			</p>
		</section>

		<!-- ===================== CTA / 13 ===================== -->
		<section class="sp-cta" id="contact">
			<h2>📬 Privacy questions?</h2>
			<p>
				Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
				Homely Fusion · 88 Rutledge Ave, Charleston, SC 29401, United States
			</p>
			<div class="sp-btns">
				<a class="sp-btn sp-btn-main" href={`mailto:${CONTACT_EMAIL}?subject=Privacy%20request`}>✉️ Email us</a>
				<a class="sp-btn sp-btn-alt" href="/disclosure/">💰 Read our Disclosure</a>
			</div>
		</section>
	</div>
</StaticPage>
