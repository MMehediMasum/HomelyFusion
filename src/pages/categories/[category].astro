---
import { slugify } from "../../utils/slug";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");
	const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
	return categories.map((category) => ({
		params: { category: slugify(category) },
		props: { categoryName: category },
	}));
}

const { categoryName } = Astro.props;
const allPosts = await getCollection("blog");
const postsInCategory = allPosts
	.filter((post) => post.data.categories.includes(categoryName))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featuredPost, ...restPosts] = postsInCategory;

// The topic this category belongs to (used for the breadcrumb)
const topicName = postsInCategory.find((post) => post.data.topic)?.data.topic;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, 92vw);
				max-width: none;
				padding-top: 1.6rem;
			}

			/* ---------- Page header ---------- */
			.page-hero {
				position: relative;
				overflow: hidden;
				margin-bottom: 2.4rem;
				padding: 2.2rem 2rem 2.3rem;
				border-radius: var(--radius-lg);
				background:
					radial-gradient(ellipse 45% 90% at 100% 0%, rgba(217, 164, 65, 0.22), transparent 65%),
					linear-gradient(160deg, #1b3532 0%, #21403b 60%, #29493f 100%);
				color: #c4d1c9;
				text-align: center;
			}
			.breadcrumb {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin: 0 0 1rem;
				padding: 0;
				list-style: none;
				font-size: 0.82rem;
			}
			.breadcrumb li {
				margin: 0;
			}
			.breadcrumb li + li::before {
				content: "/";
				margin-right: 0.4rem;
				opacity: 0.5;
			}
			.breadcrumb a {
				color: #d6e0d9;
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--brass);
			}
			.eyebrow {
				display: inline-block;
				margin-bottom: 0.7rem;
				padding: 0.25rem 0.8rem;
				border-radius: 999px;
				background: rgba(217, 164, 65, 0.16);
				border: 1px solid rgba(217, 164, 65, 0.5);
				color: var(--brass);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}
			.category-title {
				margin: 0 auto 0.5rem;
				max-width: 22ch;
				color: #fbf3e2;
				font-size: clamp(1.9rem, 4.4vw, 2.9rem);
			}
			.category-meta {
				margin: 0;
				font-size: 0.95rem;
				color: #a9bab0;
			}

			/* ---------- Featured (latest) post ---------- */
			.featured {
				display: grid;
				grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
				margin-bottom: 2.6rem;
				overflow: hidden;
				border-radius: var(--radius-lg);
				background: var(--surface);
				border: 1px solid var(--line);
				box-shadow: var(--shadow-sm);
				text-decoration: none;
				color: rgb(var(--black));
				transition: transform 0.25s ease, box-shadow 0.25s ease;
			}
			.featured:hover {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow);
				color: rgb(var(--black));
			}
			.featured-media {
				position: relative;
				min-height: 300px;
				background: linear-gradient(135deg, var(--accent-soft), rgb(var(--gray-light)));
			}
			.featured-media img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.5s ease;
			}
			.featured:hover .featured-media img {
				transform: scale(1.04);
			}
			.featured-body {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.9rem;
				padding: 2.2rem 2.4rem;
			}
			.badge {
				align-self: flex-start;
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				background: var(--brass);
				color: #1b1b1b;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.featured .title {
				margin: 0;
				font-size: clamp(1.5rem, 2.8vw, 2.1rem);
				line-height: 1.18;
				transition: color 0.2s ease;
			}
			.featured:hover .title {
				color: var(--link);
			}
			.read-more {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 0.3rem;
				font-weight: 700;
				font-size: 0.92rem;
				color: var(--link);
			}
			.read-more span {
				transition: transform 0.2s ease;
			}
			.featured:hover .read-more span,
			.card:hover .read-more span {
				transform: translateX(4px);
			}

			/* ---------- Grid ---------- */
			.section-label {
				margin: 0 0 1.2rem;
				font-family: var(--font-body);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.8rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.post-grid li {
				margin: 0;
			}
			.card {
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				border-radius: var(--radius);
				background: var(--surface);
				border: 1px solid var(--line);
				box-shadow: var(--shadow-sm);
				text-decoration: none;
				color: rgb(var(--black));
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
				border-color: rgba(var(--brass-rgb), 0.7);
				color: rgb(var(--black));
			}
			.card-media {
				position: relative;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: linear-gradient(135deg, var(--accent-soft), rgb(var(--gray-light)));
			}
			.card-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
				transition: transform 0.5s ease;
			}
			.card:hover .card-media img {
				transform: scale(1.05);
			}
			.card-body {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				gap: 0.5rem;
				padding: 1.1rem 1.2rem 1.2rem;
			}
			.card .title {
				margin: 0;
				font-size: 1.12rem;
				line-height: 1.3;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
				transition: color 0.2s ease;
			}
			.card:hover .title {
				color: var(--link);
			}
			.date {
				margin: 0;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}
			.card .read-more {
				margin-top: auto;
				padding-top: 0.5rem;
				font-size: 0.85rem;
			}
			.empty {
				text-align: center;
				color: rgb(var(--gray));
			}

			@media (max-width: 900px) {
				.post-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.featured {
					grid-template-columns: 1fr;
				}
				.featured-media {
					min-height: 0;
					aspect-ratio: 16 / 10;
				}
			}
			@media (max-width: 560px) {
				.page-hero {
					padding: 1.6rem 1.1rem 1.7rem;
					border-radius: 18px;
				}
				.featured-body {
					padding: 1.4rem 1.3rem 1.6rem;
				}
				.post-grid {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-hero">
				<ul class="breadcrumb">
					<li><a href="/">Home</a></li>
					{
						topicName && (
							<li>
								<a href={`/topic/${slugify(topicName)}/`}>{topicName}</a>
							</li>
						)
					}
					<li aria-current="page">{categoryName}</li>
				</ul>
				<span class="eyebrow">Category</span>
				<h1 class="category-title">{categoryName}</h1>
				<p class="category-meta">
					{postsInCategory.length}
					{postsInCategory.length === 1 ? " article" : " articles"}
				</p>
			</header>

			<section>
				{
					postsInCategory.length === 0 ? (
						<p class="empty">No posts found in this category yet.</p>
					) : (
						<>
							<a class="featured" href={`/${featuredPost.id}/`}>
								<div class="featured-media">
									{featuredPost.data.heroImage && (
										<img src={featuredPost.data.heroImage} alt="" width="640" height="480" loading="eager" />
									)}
								</div>
								<div class="featured-body">
									<span class="badge">Latest</span>
									<h2 class="title">{featuredPost.data.title}</h2>
									<p class="date">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<span class="read-more">
										Read article <span aria-hidden="true">→</span>
									</span>
								</div>
							</a>

							{restPosts.length > 0 && (
								<>
									<h2 class="section-label">More in {categoryName}</h2>
									<ul class="post-grid">
										{restPosts.map((post) => (
											<li>
												<a class="card" href={`/${post.id}/`}>
													<div class="card-media">
														{post.data.heroImage && (
															<img src={post.data.heroImage} alt="" width="480" height="360" loading="lazy" />
														)}
													</div>
													<div class="card-body">
														<h3 class="title">{post.data.title}</h3>
														<p class="date">
															<FormattedDate date={post.data.pubDate} />
														</p>
														<span class="read-more">
															Read article <span aria-hidden="true">→</span>
														</span>
													</div>
												</a>
											</li>
										))}
									</ul>
								</>
							)}
						</>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
